// fixture: first-run
// hypr: yes
// The first start asks before it writes Super alone into Hyprland's bindings.lua: a switch on the welcome screen, off
// until the person turns it on
const f = Quickshell.env("HOME") + "/.config/hypr/bindings.lua";
const mine = '-- mine\no.bind("SUPER + E", "Files", "nautilus")\n';
const sw = () => findAll(welcome, c => c.label === "Open with Super: adds a binding to ~/.config/hypr/bindings.lua" && c.visible)[0];
eq([root.welcomeOpen, root.welcomeFirstRun, root.superAvailable], [true, true, true], "the first start, with a bindings.lua to write to");
eq(root.readFile(f), mine, "nothing was written by loading");
ok(sw() !== undefined && sw().checked === false, "the welcome screen shows the switch, off");
keyClick(Qt.Key_Return); wait(1000);
eq([root.readFile(f), root.superMode], [mine, "off"], "Start with the switch as it came writes nothing");
eq(root.readFile(root.stateDir + "/super-key").trim(), "off", "and the choice is remembered");
// again from the start, turning it on
root.factoryReset(); wait(600);
eq(root.readFile(f), mine, "a factory reset does not touch bindings.lua");
ok(sw() !== undefined && sw().checked === false, "a factory reset asks again, with the switch off");
click(sw()); wait(200);
eq(root.welcomeSuper, true, "clicking the switch turns it on");
keyClick(Qt.Key_Return); wait(1000);
ok(root.readFile(f).indexOf(">>> gona-launcher:super") > 0 && root.superMode === "tiles", "Start with it on adds Super alone");
ok(root.readFile(f).startsWith(mine), "and keeps the person's own lines");
// a factory reset with the block in place: the switch is not shown and Start leaves the block as it is
root.factoryReset(); wait(600);
const withBlock = root.readFile(f);
eq(sw(), undefined, "no switch while bindings.lua already has the block");
keyClick(Qt.Key_Return); wait(1000);
eq([root.readFile(f), root.superMode], [withBlock, "tiles"], "Start leaves the block (Off is ⚙ > Keys' job)");
finish();
