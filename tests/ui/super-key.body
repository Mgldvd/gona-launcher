// Super alone: never written by loading the plugin; added, changed and removed from ⚙ > Keys, and "Off" sticks
// hypr: yes
const f = Quickshell.env("HOME") + "/.config/hypr/bindings.lua";
const mine = '-- mine\no.bind("SUPER + E", "Files", "nautilus")\n';
eq([root.superAvailable, root.superMode], [true, "off"], "loading the plugin does not add Super alone: that needs the person's consent");
wait(500);
eq(root.readFile(f), mine, "bindings.lua is untouched");
root.setSuperMode("tiles"); wait(500);
eq(root.superMode, "tiles", "choosing Tiles in ⚙ > Keys adds it");
let text = root.readFile(f);
ok(text.startsWith(mine), "the person's own lines are kept");
ok(text.indexOf('o.bind("SUPER + SUPER_L", "Gona Launcher", "omarchy-shell shell toggle gona.launcher", { release = true })') > 0, "the binding is in the file");
eq(root.readFile(root.stateDir + "/super-key").trim(), "tiles", "the first-time setup is remembered");
root.setSuperMode("allApps"); wait(500);
text = root.readFile(f);
eq([root.superMode, text.split(">>> gona-launcher:super").length], ["allApps", 2], "All apps replaces the block, it is not added twice");
ok(text.indexOf("'{\\\"allApps\\\":true}'") > 0, "the binding opens all apps");
root.setSuperMode("off"); wait(500);
eq(root.readFile(f), mine, "Off gives the file back as it was");
root.refreshSuperKey(); wait(300);
eq([root.superMode, root.readFile(f)], ["off", mine], "Off sticks: the next open does not add it again");
// a Super-alone binding written by hand is the person's: it is never removed, and no block is added beside it
// (both would fire on one release, opening and closing the launcher at once)
const hand = mine + '-- tap Super\no.bind("SUPER + SUPER_L", "Gona Launcher", "omarchy-shell shell toggle gona.launcher", { release = true })\n';
root.writeFile(f, hand); root.refreshSuperKey(); wait(300);
eq([root.superByHand, root.superMode], [true, "off"], "the line is seen as the person's own");
root.setSuperMode("tiles"); wait(500);
eq([root.readFile(f), root.superMode], [hand, "off"], "choosing Tiles leaves the file exactly as it was");
finish();
